# ─────────────────────────────────────────────────────────────────────
# Multimodal Annotator — backend environment template
#
# Copy to `.env` and adjust. The `.env` file is gitignored; this template is
# committed so contributors know which variables exist.
# ─────────────────────────────────────────────────────────────────────

# Tool-owned base namespace. Used to mint mma:* predicates (e.g. mma:profile).
# Configurable in one place so the tool's canonical URI can change without
# touching code or templates.
BASE_NS=https://w3id.org/multimodal-annotator/ns/

# Single-user creator IRI used by the HICO provenance generator until Phase 3
# replaces it with real authentication. Set to your ORCID (or any stable IRI).
DEFAULT_CREATOR_IRI=https://orcid.org/0000-0002-4115-0078

# Fuseki dataset URL. Inside docker-compose this resolves to the `fuseki`
# service; for a local non-docker run, use http://localhost:3030/mma.
FUSEKI_URL=http://fuseki:3030/mma

# CORS allow-list for the gateway. Comma-separated origins. Include the Vite
# dev server in development.
CORS_ORIGINS=http://localhost:5173
