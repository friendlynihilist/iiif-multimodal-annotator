{
  "_comment": "JSON-LD context for the default interim-geko profile. Namespaces verified by Carlo on 2026-05-13. The w3id.org redirects for interim/, geko/, mlao/, hico/, and multimodal-annotator/ns/ are pending registration (Carlo). LRMoo uses the historical http://iflastandards.info/ns/lrm/lrmoo/ — kept stable across this codebase. The tool-owned namespace `mma:` (https://w3id.org/multimodal-annotator/ns/) is the configurable BASE_NS on the backend.",

  "@context": {
    "@version": 1.1,

    "oa":       "http://www.w3.org/ns/oa#",
    "as":       "https://www.w3.org/ns/activitystreams#",
    "dcterms":  "http://purl.org/dc/terms/",
    "dc":       "http://purl.org/dc/elements/1.1/",
    "foaf":     "http://xmlns.com/foaf/0.1/",
    "skos":     "http://www.w3.org/2004/02/skos/core#",
    "rdf":      "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs":     "http://www.w3.org/2000/01/rdf-schema#",
    "owl":      "http://www.w3.org/2002/07/owl#",
    "xsd":      "http://www.w3.org/2001/XMLSchema#",
    "prov":     "http://www.w3.org/ns/prov#",

    "crm":      "http://www.cidoc-crm.org/cidoc-crm/",
    "lrmoo":    "http://iflastandards.info/ns/lrm/lrmoo/",
    "dctypes":  "http://purl.org/dc/dcmitype/",

    "mma":      "https://w3id.org/multimodal-annotator/ns/",
    "interim":  "https://w3id.org/interim/",
    "geko":     "https://w3id.org/geko/",
    "mlao":     "https://w3id.org/mlao/",
    "icon":     "https://w3id.org/icon/ontology/",
    "hico":     "https://w3id.org/hico/",

    "iiif":     "http://iiif.io/api/presentation/3#",
    "sc":       "http://iiif.io/api/presentation/2#",

    "id":       "@id",
    "type":     "@type",

    "Annotation":        "oa:Annotation",
    "AnnotationPage":    "oa:AnnotationPage",
    "AnnotationCollection": "oa:AnnotationCollection",

    "Image":             "dctypes:Image",
    "Text":              "dctypes:Text",
    "Video":             "dctypes:MovingImage",
    "Audio":             "dctypes:Sound",
    "Dataset":           "dctypes:Dataset",
    "Software":          "dctypes:Software",

    "assessing":     "oa:assessing",
    "bookmarking":   "oa:bookmarking",
    "classifying":   "oa:classifying",
    "commenting":    "oa:commenting",
    "describing":    "oa:describing",
    "editing":       "oa:editing",
    "highlighting":  "oa:highlighting",
    "identifying":   "oa:identifying",
    "linking":       "oa:linking",
    "moderating":    "oa:moderating",
    "questioning":   "oa:questioning",
    "replying":      "oa:replying",
    "tagging":       "oa:tagging",
    "transcribing":  "oa:transcribing",
    "painting":      "iiif:painting",

    "body":              { "@id": "oa:hasBody",   "@type": "@id" },
    "target":            { "@id": "oa:hasTarget", "@type": "@id" },
    "source":            { "@id": "oa:hasSource", "@type": "@id" },
    "selector":          { "@id": "oa:hasSelector" },
    "motivation":        { "@id": "oa:motivatedBy", "@type": "@vocab" },
    "value":             "rdf:value",
    "format":            "dcterms:format",
    "language":          "dcterms:language",
    "purpose":           { "@id": "oa:hasPurpose", "@type": "@vocab" },
    "conformsTo":        { "@id": "dcterms:conformsTo", "@type": "@id" },

    "TextualBody":           "oa:TextualBody",
    "Choice":                "oa:Choice",
    "SpecificResource":      "oa:SpecificResource",
    "FragmentSelector":      "oa:FragmentSelector",
    "TextPositionSelector":  "oa:TextPositionSelector",
    "TextQuoteSelector":     "oa:TextQuoteSelector",
    "SvgSelector":           "oa:SvgSelector",
    "RangeSelector":         "oa:RangeSelector",

    "start":  { "@id": "oa:start", "@type": "xsd:nonNegativeInteger" },
    "end":    { "@id": "oa:end",   "@type": "xsd:nonNegativeInteger" },
    "exact":  "oa:exact",
    "prefix": "oa:prefix",
    "suffix": "oa:suffix",

    "created":  { "@id": "dcterms:created",  "@type": "xsd:dateTime" },
    "modified": { "@id": "dcterms:modified", "@type": "xsd:dateTime" },
    "creator":  { "@id": "dcterms:creator",  "@type": "@id" },

    "items":    { "@id": "as:items", "@container": "@list" },
    "label":    "rdfs:label",

    "profile":             { "@id": "mma:profile", "@type": "@id" },

    "class":           { "@id": "rdf:type", "@type": "@vocab" },
    "property":        { "@id": "geko:hasEkphrasticModality", "@type": "@id" },
    "modality":        { "@id": "geko:hasEkphrasticModality", "@type": "@vocab" },
    "canvasId":        { "@id": "mma:canvasId",    "@type": "@id" },
    "canvasIndex":     { "@id": "mma:canvasIndex", "@type": "xsd:integer" },
    "canvasLabel":     "mma:canvasLabel",
    "lineId":          "mma:lineId",
    "coords":          "mma:coords",
    "pageNr":          { "@id": "mma:pageNr", "@type": "xsd:integer" },
    "annotationType":  "mma:annotationType",

    "denotation":   "geko:denotation",
    "dynamisation": "geko:dynamisation",
    "integration":  "geko:integration",
    "hasEkphrasticModality": { "@id": "geko:hasEkphrasticModality", "@type": "@vocab" },
    "hasTextualReferent":    { "@id": "geko:hasTextualReferent",    "@type": "@id" },
    "hasIconicReferent":     { "@id": "geko:hasIconicReferent",     "@type": "@id" },

    "IntermedialRelation": "interim:IntermedialRelation",
    "IntermedialObject":   "interim:IntermedialObject",
    "Medium":              "interim:Medium",
    "producesObject":      { "@id": "interim:producesObject", "@type": "@id" },
    "hasSourceMedium":     { "@id": "interim:hasSourceMedium", "@type": "@id" },
    "hasTargetMedium":     { "@id": "interim:hasTargetMedium", "@type": "@id" },

    "Anchor":             "mlao:Anchor",
    "hasAnchor":          { "@id": "mlao:hasAnchor", "@type": "@id" },
    "isAnchoredTo":       { "@id": "mlao:isAnchoredTo", "@type": "@id" },
    "hasConceptualLevel": { "@id": "mlao:hasConceptualLevel", "@type": "@id" },

    "PreiconographicalSubject": "icon:PreiconographicalSubject",
    "IconographicalSubject":    "icon:IconographicalSubject",
    "IconologicalSubject":      "icon:IconologicalSubject",

    "InterpretationAct":          "hico:InterpretationAct",
    "wasGeneratedBy":             { "@id": "hico:wasGeneratedBy", "@type": "@id" },
    "hasInterpretationType":      "hico:hasInterpretationType",
    "hasInterpretationCriterion": { "@id": "hico:hasInterpretationCriterion", "@type": "@id" },

    "F1_Work":       "lrmoo:F1_Work",
    "F2_Expression": "lrmoo:F2_Expression",
    "F3_Manifestation": "lrmoo:F3_Manifestation",
    "F5_Item":       "lrmoo:F5_Item",
    "F27_Work_Creation":       "lrmoo:F27_Work_Creation",
    "F28_Expression_Creation": "lrmoo:F28_Expression_Creation",
    "R3_is_realised_in":       { "@id": "lrmoo:R3_is_realised_in", "@type": "@id" },
    "R16_created":             { "@id": "lrmoo:R16_created",        "@type": "@id" },
    "R17_created":             { "@id": "lrmoo:R17_created",        "@type": "@id" },

    "E22_Human-Made_Object": "crm:E22_Human-Made_Object",
    "E36_Visual_Item":       "crm:E36_Visual_Item",
    "E33_Linguistic_Object": "crm:E33_Linguistic_Object",
    "P138_represents":       { "@id": "crm:P138_represents", "@type": "@id" }
  }
}
